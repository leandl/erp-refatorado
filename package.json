{
  "name": "erp-refatorado",
  "version": "0.0.0",
  "description": "",
  "main": "src/main.ts",
  "scripts": {
    "build": "tsup --tsconfig tsconfig.build.json src/main.ts",
    "start": "node dist/main.cjs",
    "dev:app:run": "tsx --env-file .env.dev --watch src/main.ts",
    "dev": "npm run services:up && npm run services:wait:database && npm run db:migrate && npm run dev:app:run",
    "test": "npm run services:up && concurrently -n app,test --hide app -k --success command-test \"npm run dev:app:run\" \"vitest run --passWithNoTests\"",
    "posttest": "npm run services:stop",
    "test:watch": "vitest --passWithNoTests",
    "prepare": "husky",
    "lint:fix": "eslint src --ext .ts --fix",
    "db:migrate": "node --env-file .env.dev ./node_modules/knex/bin/cli.js migrate:latest",
    "db:rollback": "node --env-file .env.dev ./node_modules/knex/bin/cli.js migrate:rollback",
    "services:up": "docker compose --env-file .env.dev -f infra/compose.yaml up -d",
    "services:stop": "docker compose --env-file .env.dev -f infra/compose.yaml stop",
    "services:down": "docker compose --env-file .env.dev -f infra/compose.yaml down",
    "services:wait:database": "node ./infra/scripts/wait-for-database.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@rocketseat/eslint-config": "^2.2.2",
    "@types/async-retry": "^1.4.9",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "24",
    "@types/sinon": "^21.0.1",
    "async-retry": "^1.3.3",
    "axios": "^1.17.0",
    "concurrently": "^10.0.5",
    "eslint": "^8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "git-commit-msg-linter": "^5.0.8",
    "husky": "^9.1.7",
    "knex": "^3.2.10",
    "lint-staged": "^17.0.6",
    "nock": "^14.0.16",
    "prisma": "^7.9.1",
    "sinon": "^22.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "resolutions": {
    "@typescript-eslint/typescript-estree": "^8"
  },
  "lint-staged": {
    "*.ts": "npm run lint:fix --"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@hono/node-server": "^2.1.1",
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "better-sqlite3": "^13.0.2",
    "cors": "^2.8.6",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "fastify": "^5.10.0",
    "hono": "^4.13.5",
    "mongodb": "^7.6.0",
    "mysql2": "^3.23.1",
    "pg": "^8.22.0",
    "pg-promise": "^12.7.0",
    "sqlite3": "^6.0.1",
    "typeorm": "^1.1.0"
  }
}
